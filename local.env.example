# Local Environment Configuration Template
# Copy this file to 'local.env' and populate your credentials.
# NOTE: Never commit your actual 'local.env' file.

# Local Model Proxy (backed by Google Cloud Vertex AI or LiteLLM)
MODEL_PROXY_URL=http://localhost:4000
MODEL_PROXY_KEY=ple-local-proxy-dev-token

# Google Cloud Project (for Vertex AI model proxy)
VERTEXAI_PROJECT=your-gcp-project-id
GOOGLE_APPLICATION_CREDENTIALS=/path/to/application_default_credentials.json

# Hugging Face Access Token (for downloading gated dev tasks)
HF_TOKEN=hf_your_read_token_here

# Optional: Personal direct API keys for local model testing
OPENAI_API_KEY=sk-...
GEMINI_API_KEY=AIzaSy...
ANTHROPIC_API_KEY=sk-ant-...

# Evaluation Judge Configuration (defaults to Claude Opus 5.5 proxy)
# JUDGE_BASE_URL=http://localhost:4000/v1
# JUDGE_API_KEY=ple-local-proxy-dev-token
# JUDGE_MODEL=claude-opus-5-5-judge
